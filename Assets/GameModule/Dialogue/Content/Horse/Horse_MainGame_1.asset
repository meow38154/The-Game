  <DialogueBundleData>k__BackingField:
  - profile: {fileID: 11400000, guid: 80601025e9725664faf1153876918480, type: 2}
    dialogues:
    - "\uD788\uD799!"
    - "\uB108\uB3C4 \uB2F9\uADFC \uC88B\uC544\uD574?"
    - "\uB098\uB294 \uC815\uB9D0 \uC88B\uC544\uD574!"
    - "\uC0AC\uC2E4 \uC800\uAE30 \uB2F9\uADFC\uBC2D\uC5D0 \uC544\uC8FC \uB9DB\uC788\uC5B4 \uBCF4\uC774\uB294 \uB2F9\uADFC\uB4E4\uC774 \uC788\uAC70\uB4E0."
    - "\uADF8\uB7F0\uB370 \uB0B4\uAC00 \uB4E4\uC5B4\uAC00\uBA74 \uC548 \uB3FC."
    - "\uC800\uBC88\uC5D0 \uD55C \uBC88 \uB4E4\uC5B4\uAC14\uB2E4\uAC00..."
    - "\uC138 \uC904\uC774\uB098 \uBC1F\uC544\uBC84\uB838\uAC70\uB4E0."
    - "\uD5E4\uD5E4..."
    - "\uADF8 \uB4A4\uB85C\uB294 \uCD9C\uC785 \uAE08\uC9C0\uB798."
    - "\uD639\uC2DC \uB2F9\uADFC \uD558\uB098\uB9CC \uAC00\uC838\uB2E4\uC904 \uC218 \uC788\uC744\uAE4C?"
    - "\uC9C4\uC9DC \uD558\uB098\uB9CC!"
    - "\uC544\uB9C8 \uB458... \uC138 \uAC1C\uB3C4 \uAD1C\uCC2E\uC744 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uC9C0\uB9CC..."