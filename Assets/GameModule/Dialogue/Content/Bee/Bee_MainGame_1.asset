  <DialogueBundleData>k__BackingField:
  - profile: {fileID: 11400000, guid: c10888a0652007e4c88e5c5f3f8cd719, type: 2}
    dialogues:
    - "\uC5B4... \uC775\uC2A4\uD050\uC988 \uBBF8... \uD639\uC2DC \uB0B4 \uBC8C\uC9D1
      \uBCF8 \uC801 \uC788\uC5B4\uC694?"
    - "\uB098 \uC9C0\uAE08 \uBC8C\uC9D1 \uC783\uC5B4\uBC84\uB838\uC5B4\uC694..."
    - "\uC5EC\uAE30 \uB108\uBB34 \uCF5C\uB4DC\uD574\uC694. \uBC24 \uB418\uBA74 \uC719\uB3C4
      \uC798 \uC548 \uC6C0\uC9C1\uC5EC\uC694."
    - "\uBC8C\uC9D1 \uC5C6\uC73C\uBA74 \uB098 \uC624\uB298 \uC2AC\uB9BD \uBABB \uD574\uC694..."
    - "\uD639\uC2DC \uBC8C\uC9D1 \uC5B4\uB514 \uC788\uB294\uC9C0 \uC54C\uBA74 \uB098\uD55C\uD14C
      \uC54C\uB824\uC904 \uC218 \uC788\uC5B4\uC694?"
    - "\uD50C\uB9AC\uC988... \uB098 \uC9C4\uC9DC \uC870\uAE08 \uB370\uC2A4\uD37C\uB808\uC774\uD2B8
      \uD574\uC694."
