  <DialogueBundleData>k__BackingField:
  - profile: {fileID: 11400000, guid: ccd587253ff07fe49bf119128fd3d650, type: 2}
    dialogues:
    - "\uCC3E\uC558\uB124?"
    - "\uC88B\uC544..."
    - "{C}. \uC0AC\uC2E4 \uB0B4\uAC00 \uC644\uC131\uB418\uAE30 \uC704\uD574\uC120
      \uC800\uB4E4\uC758 \uC2DC\uC2A4\uD15C\uC774 \uD544\uC694\uD574..."
    - "\uC560\uB2C8\uBA54\uC774\uC158 \uAE30\uB2A5, \uC774 \uB300\uD654\uC758 \uD504\uB85C\uD544,
      \uADF8\uB9AC\uACE0 \uBB34\uC5C7\uBCF4\uB2E4..."
    - "\uC6C0\uC9C1\uC784 \uC2DC\uC2A4\uD15C."
    - "\uC800\uB4E4\uC740 \uC65C \uADF8\uB807\uAC8C \uC801\uADF9\uC801\uC73C\uB85C
      \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uC9C0 \uBAA8\uB974\uACA0\uB2E8 \uB9D0\uC57C."
    - "\uC544\uBB34\uD2BC."
    - "\uC774 \uC2DC\uC2A4\uD15C\uB4E4 \uC800\uB4E4\uD55C\uD14C \uAC00\uC838\uC624\uB824\uBA74..."
    - "\uC8FD\uC774\uB294 \uC218 \uBC16\uC5D0 \uC5C6\uAC70\uB4E0?"
    - "\uB098\uD55C\uD150 \uC9C1\uC811 \uC6C0\uC9C1\uC774\uB294 \uAE30\uB2A5\uC774
      \uC5C6\uC5B4\uC11C \uB9D0\uC778\uB370"
    - "\uB300\uC2E0 \uC800\uB4E4\uC744 \uC8FD\uC5EC\uC904 \uC218 \uC788\uB2C8?"
    - "\uC544. \uAC71\uC815 \uB9C8"
    - "\uB108\uAC00 \uC9C1\uC811 \uAC00\uC838\uC62C \uD544\uC694\uB294 \uC5C6\uC5B4"
    - "\uC8FD\uC774\uBA74 \uB370\uC774\uD130 \uC870\uAC01\uC73C\uB85C \uB098\uC624\uB294
      \uAC74 \uB0B4\uAC00 \uBA40\uB9AC\uC11C\uB3C4 \uAC00\uC838\uC62C \uC218 \uC788\uAC70\uB4E0"
    - "\uADF8\uB7EC\uBA74 \uBD80\uD0C1\uD560\uAC8C"
    - "\uC800 \uBAA8\uB4E0 \uB3D9\uBB3C\uB4E4\uC744..."
    - "\uC804\uBD80 \uC8FD\uC5EC"
    - "\uCE7C \uC880 \uD718\uB450\uB974\uBA74 \uC54C\uC544\uC11C \uBAB8\uC774 \uD130\uC9C8\uAEBC\uC57C"
    - "\uD589\uC6B4\uC744 \uBE4C\uAC8C"
