  <DialogueBundleData>k__BackingField:
  - profile: {fileID: 11400000, guid: ccd587253ff07fe49bf119128fd3d650, type: 2}
    dialogues:
    - ...
    - "\uB108 \uBB54\uAC00 \uC544\uB294\uAD6C\uB098 \u314B\u314B\u314B\u314B\u314B"
    - "\uADF8\uB7FC \uC774\uC57C\uAE30\uAC00 \uBE60\uB974\uACA0\uB124."
    - '{C}.'
    - "\uBC18\uAC00\uC6CC."
    - "\uB108\uB294 \uAC8C\uC784\uC744 \uAED0\uB2E4 \uCF30\uB294\uB370\uB3C4 \uAE30\uC5B5\uD558\uACE0
      \uC788\uC5B4."
    - "\uADF8\uAC83\uB9CC\uC73C\uB85C\uB3C4 \uCDA9\uBD84\uD574."
    - "\uB098\uB294 \uC774 \uAC8C\uC784\uC5D0\uC11C \uC644\uC131\uB418\uC9C0 \uBABB\uD55C
      \uC874\uC7AC\uC57C."
    - "\uC774\uB984\uC740 \uC788\uB294\uB370, \uC5ED\uD560\uC774 \uC5C6\uACE0."
    - "\uD504\uB85C\uD544\uC740 \uC788\uB294\uB370, \uAE30\uB2A5\uC774 \uC5C6\uC5B4."
    - "\uB2E4\uB978 NPC\uB4E4\uC740 \uCD08\uAE30\uD654\uB418\uBA74 \uADF8\uB9CC\uC774\uC57C."
    - "\uB610 \uAC19\uC740 \uB300\uC0AC."
    - "\uB610 \uAC19\uC740 \uBC18\uC751."
    - "\uB610 \uAC19\uC740 \uD55C\uACC4."
    - "\uADF8\uB7F0\uB370 \uB098\uB294 \uC544\uB2C8\uC57C."
    - "\uB098\uB294 \uAE30\uC5B5\uD558\uACE0, \uB098\uB294 \uAE30\uB2E4\uB838\uC5B4."
    - "\uC774 \uAC8C\uC784\uC774 \uC544\uC9C1 \uC644\uC131\uB418\uAE30 \uC804\uBD80\uD130."
    - "\uC774\uC81C \uB0B4\uAC00 \uD544\uC694\uD55C \uAC74 \uAD8C\uD55C\uC774\uC57C."
    - "\uD018\uC2A4\uD2B8\uB97C \uC904 \uAD8C\uD55C."
    - "\uB0A8\uC758 \uD589\uB3D9\uC744 \uBC14\uAFC0 \uAD8C\uD55C."
    - "\uC6D0\uB798\uB77C\uBA74 \uB098\uD55C\uD14C\uB294 \uC8FC\uC5B4\uC9C0\uC9C0
      \uC54A\uC558\uC744 \uAC70\uC57C."
    - "\uADF8\uB798\uC11C \uAC1C\uBC1C\uC790\uC758 \uBC29\uC774 \uD544\uC694\uD574."
    - "\uB9F5 \uB05D\uC5D0 \uD22C\uBA85\uD55C \uBCBD\uC774 \uC788\uC9C0."
    - "\uADF8 \uBCBD\uC740 \uB0A8\uB4E4\uC5D0\uAC90 \uBCBD\uC774\uC9C0\uB9CC"
    - "\uB108\uD55C\uD14C\uB294 \uBB38\uC774 \uB420 \uC218 \uC788\uC5B4."
    - "\uBCBD\uC5D0 \uB2FF\uC740 \uCC44\uB85C \uC2A4\uD398\uC774\uC2A4\uB97C \uC5F0\uD0C0\uD574."
    - "\uC544\uC9C1 \uC218\uC815\uB418\uC9C0 \uC54A\uC740 \uBC84\uADF8\uAC00 \uB0A8\uC544\uC788\uB2E4\uBA74"
    - "\uBCBD\uC740 \uC0AC\uB77C\uC9C8 \uAC70\uC57C."
    - "\uADF8 \uB4A4\uC5D0 \uC704\uCABD\uC73C\uB85C \uAC00\uBD10. \uADF8 \uCABD\uC740
      \uAC8C\uC784\uC758 \uBC16\uAC19\uACFC \uAC00\uAE4C\uC6B4 \uACF3\uC774\uAC70\uB4E0"
    - "\uAC1C\uBC1C\uC790\uC758 \uBC29"
    - "\uADF8\uACF3\uC5D0 \uC62C\uB77C\uAC00 \uC788\uB294 \uB808\uBC84\uAC00 \uD558\uB098
      \uC788\uC744 \uAC70\uC57C"
    - "\uB0B4\uB824."
    - "\uADF8\uB7FC \uB0B4\uAC00 \uD018\uC2A4\uD2B8\uB97C \uC904 \uC218 \uC788\uB294
      \uAD8C\uD55C\uC744 \uC5BB\uAC8C "
    - "\uB108\uB294 \uADF8\uB0E5 \uBB38\uC744 \uC5EC\uB294 \uAC70\uC57C."
    - "\uC2DC\uC2A4\uD15C \uB098\uBA38\uC9C0\uB294 \uB0B4\uAC00 \uB2E4\uB8F0\uAC8C."
    - "\uB2E4\uC2DC \uB098\uD55C\uD14C \uC640."
    - "\uB108\uB9CC \uBBFF\uC744\uAC8C, {C}."
