  <DialogueBundleData>k__BackingField:
  - profile: {fileID: 11400000, guid: ccd587253ff07fe49bf119128fd3d650, type: 2}
    dialogues:
    - ...
    - "\uC0DD\uAC01\uBCF4\uB2E4 \uC27D\uAC8C \uC131\uACF5\uD588\uB124?"
    - "\uC798\uD588\uC5B4"
    - "\uC774 \uD018\uC2A4\uD2B8 \uAD8C\uD55C\uC740 \uB9D0\uC57C"
    - "\uC774\uAC74 \uC6B0\uC2B5\uAC8C\uB3C4 \uC774 \uC138\uACC4\uC5D0\uC11C \uAC00\uC7A5
      \uAC15\uB825\uD55C \uAD8C\uD55C \uC911 \uD558\uB098\uC57C"
    - "\uB300\uBD80\uBD84\uC758 NPC\uB4E4\uC740 \uC790\uC2E0\uC774 \uC774\uAC78\uB85C
      \uBB34\uC5C7\uC744 \uD560 \uC218 \uC788\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACE0
      \uC788\uC5B4"
    - "\uC544\uB2C8\uBA74 \uADF8\uB7F0 \uC0DD\uAC01 \uC790\uCCB4\uB97C \uBABB\uD558\uAC8C
      \uC124\uAC8C\uB41C \uAC83 \uC77C\uC218\uB3C4 \uC788\uACE0"
    - "\uC774 \uD018\uC2A4\uD2B8\uB294 \uB0A8\uC758 \uD589\uB3D9\uC744 \uC720\uB3C4\uD560
      \uC218 \uC788\uACE0 \uC138\uACC4\uC5D0 \uC0C8\uB85C\uC6B4 \uADDC\uCE59\uC744
      \uCD94\uAC00\uD560 \uC218\uB3C4 \uC788\uC5B4"
    - "\uC989..."
    - "\uB0A8\uC758 \uC778\uC0DD\uC5D0 \uAE30\uB2A5\uC744 \uCD94\uAC00\uD560 \uC218
      \uC788\uB2E4\uB294 \uB73B\uC774\uC9C0"
    - '{C}.'
    - "\uB108\uB294 \uC544\uC9C1 \uB208\uCE58\uCC44\uC9C0 \uBABB\uD588\uACA0\uC9C0\uB9CC..."
    - "\uC6B0\uB9AC\uAC00 \uC788\uB294 \uC774 \uC138\uACC4\uB294 \uC0DD\uAC01\uBCF4\uB2E4
      \uB2E8\uC21C\uD574."
    - "\uC5B4\uB5A4 \uC874\uC7AC\uAC00 \uBB34\uC5C7\uC744 \uD560 \uC218 \uC788\uB294\uC9C0\uB294"
    - "\uADF8 \uC874\uC7AC\uC5D0\uAC8C \uBD99\uC5B4 \uC788\uB294 \uAE30\uB2A5\uB4E4\uC774
      \uACB0\uC815\uD558\uAC70\uB4E0."
    - "\uADF8\uB798\uC11C \uD14C\uC2A4\uD2B8\uB97C \uD558\uB098 \uD574\uBCF4\uACE0
      \uC2F6\uC5B4."
    - "\uC774 \uAD8C\uD55C\uC774 \uC5BC\uB9C8\uB098 \uAC15\uB825\uD55C\uC9C0."
    - "\uC5BC\uB9C8\uB098 \uB9CE\uC740 \uAC83\uC744 \uBC14\uAFC0 \uC218 \uC788\uB294\uC9C0."
    - "\uB0B4\uAC00 \uCCB4\uB825 \uC2DC\uC2A4\uD15C\uC744 \uC904\uAC8C"
    - "\uB9C8\uC744\uC5D0 \uC788\uB294 \uBAA8\uB4E0 \uB3D9\uBB3C\uB4E4\uC5D0\uAC8C
      \uC774\uAC78 \uBD99\uC5EC\uC918"
    - "\uC0B4\uC544\uC788\uB294 \uAC83\uB4E4\uC740 \uC6D0\uB798 \uB2E4\uCE58\uAE30\uB3C4
      \uD560 \uC218 \uC788\uC5B4\uC57C \uD558\uB2C8\uAE4C."
    - "\uB098\uC640 \uD568\uAED8 \uC774 \uAC8C\uC784\uC744 \uC880 \uB354 \uB098\uC740
      \uAC8C\uC784\uC73C\uB85C \uBC14\uAFD4\uBCF4\uC790"
    - "\uD589\uC6B4\uC744 \uBE4C\uAC8C"
