  <DialogueBundleData>k__BackingField:
  - profile: {fileID: 11400000, guid: 3b4bc510605fa7f48815227a7558aa0b, type: 2}
    dialogues:
    - "\uC74C... \uC804 \uC5EC\uAE30 \uAC1C\uBC1C\uC790\uC778\uB370\uC694"
    - "\uAC8C\uC784\uC5D0\uC11C \uBB54\uAC00 \uC774\uC0C1\uD55C \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB358
      \uAC83 \uAC19\uC544\uC11C \uC640 \uBD24\uB294\uB370"
    - "\uB531\uD788 \uBB38\uC81C\uB294 \uC5C6\uB294 \uAC83 \uAC19\uB124\uC694?"
    - "\uBB50\uC9C0? \uBD84\uBA85 \uBB54\uAC00 \uCF58\uC194\uC774 \uC5C4\uCCAD\uB098\uAC8C
      \uB5B4\uC5C8\uB294\uB370...?"
    - "\uC0AC\uC2E4 \uC800 \uCABD \uC544\uB798 \uB9F5\uC744 \uB6AB\uACE0 \uAC00\uBA74
      \uD504\uB85C\uD1A0\uD0C0\uC785 \uB9F5\uC774 \uC788\uAC70\uB4E0\uC694?"
    - "\uAC70\uAE30\uC11C \uC77C\uC5B4\uB09C\uAC74\uAC00?"
    - "\uC77C\uB2E8 \uD639\uC2DC \uBAB0\uB77C\uC11C \uD018\uC2A4\uD2B8\uB294 \uB2E4
      \uB9C9\uC544\uB480\uC5B4\uC694."
    - "\uC815 \uAC8C\uC784\uD558\uC2DC\uACE0 \uC2F6\uC73C\uC2DC\uBA74 \uC800\uAE30
      \uC544\uB798 \uCABD \uD504\uB85C\uD1A0\uD0C0\uC785 \uB9F5 \uAC00\uC11C \uD558\uC2DC\uC838"
